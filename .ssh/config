# ssh bruger den FØRSTE værdi den møder for hver option — specifikke
# Host-blokke skal derfor stå før de generelle defaults i "Host *" nederst.

# Hetzner-bokse: én nøgle pr. server (privatnøglen ligger i 1Password,
# .pub-filen fortæller agenten hvilken nøgle der skal bruges).
Host monitor
  Hostname 178.104.214.109
  User root
  IdentityFile ~/.ssh/hetzner-monitor.pub

Host panel
  Hostname 167.233.118.181
  User root
  IdentityFile ~/.ssh/hetzner-panel.pub

Host redash
  Hostname 167.233.104.114
  User root
  IdentityFile ~/.ssh/hetzner-redash.pub

Host livekit
  Hostname 178.104.227.25
  User root
  IdentityFile ~/.ssh/hetzner-livekit.pub

Host og-image-fetcher
  Hostname 49.13.237.81
  User root
  IdentityFile ~/.ssh/hetzner-og-image-fetcher.pub

# Gigalixir (`gigalixir ps:ssh`, remote_console). Nøglen er registreret på
# kontoen anders@oase.app via `gigalixir account:ssh_keys:add`.
Host *.ssh.gigalixir.com
  IdentityFile ~/.ssh/gigalixir.pub

# Hjemme-Pi: "home" via Tailscale (MagicDNS), "home.local" på hjemmenettet.
Host home home.local 100.89.125.87 192.168.50.10
  User anders
  IdentityFile ~/.ssh/hjemme-pi.pub

Host github.com
  User git
  IdentityFile ~/.ssh/github.pub

Host monitor panel redash livekit og-image-fetcher *.ssh.gigalixir.com github.com home home.local 100.89.125.87 192.168.50.10
  IdentitiesOnly yes
  ForwardAgent no

Host *
  ForwardAgent no
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
